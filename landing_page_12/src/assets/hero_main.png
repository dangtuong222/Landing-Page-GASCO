<?xml version="1.0" encoding="UTF-8"?>
<svg width="1200" height="800" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#020817"/>
      <stop offset="100%" stop-color="#0b172a"/>
    </linearGradient>
    <linearGradient id="cyanGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#00f2fe"/>
      <stop offset="100%" stop-color="#a78bfa"/>
    </linearGradient>
    <linearGradient id="plumeGrad" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="rgba(0, 242, 254, 0.5)"/>
      <stop offset="60%" stop-color="rgba(167, 139, 250, 0.3)"/>
      <stop offset="100%" stop-color="rgba(0, 242, 254, 0)"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background Base -->
  <rect width="1200" height="800" fill="url(#bgGrad)"/>
  <rect width="1200" height="800" fill="url(#grid)"/>

  
  <!-- Outer Frame -->
  <rect x="20" y="20" width="1160" height="760" rx="16" fill="rgba(15,23,42,0.8)" stroke="#00f2fe" stroke-width="2"/>
  
  <!-- HUD Header -->
  <rect x="50" y="50" width="1100" height="90" rx="12" fill="rgba(2,8,23,0.9)" stroke="rgba(0,242,254,0.4)" stroke-width="1.5"/>
  <text x="80" y="90" fill="#00f2fe" font-family="Space Grotesk, sans-serif" font-size="22" font-weight="bold">SERVICE S0294: LANDFILL METHANE VERTICAL PROFILING &amp; MRV REPORTING</text>
  <text x="80" y="120" fill="#94a3b8" font-family="Inter, sans-serif" font-size="14">UAV Open-Path Laser Spectroscopy + Downwind Multi-Altitude Transects &amp; Mass Balance</text>

  <!-- Landfill Cell Contour -->
  <path d="M 50 620 Q 300 520, 600 560 T 1150 500 L 1150 720 L 50 720 Z" fill="#0d2347" stroke="#00f2fe" stroke-width="2"/>

  <!-- Gas Flare Stack & Upwind Line -->
  <circle cx="180" cy="560" r="10" fill="#f59e0b"/>
  <line x1="180" y1="180" x2="180" y2="560" stroke="#f59e0b" stroke-width="2" stroke-dasharray="6,4"/>
  <text x="110" y="170" fill="#f59e0b" font-family="Space Grotesk, sans-serif" font-size="14">Upwind Baseline (Phía đón gió)</text>

  <!-- Downwind Methane Plume Contour -->
  <path d="M 380 560 Q 600 380, 880 260 Q 1050 180, 1150 140 L 1150 560 Z" fill="url(#plumeGrad)"/>

  <!-- Multi-Altitude Transect Lines -->
  <!-- 100m -->
  <line x1="220" y1="220" x2="1100" y2="220" stroke="#00f2fe" stroke-width="2.5" stroke-dasharray="8,5"/>
  <rect x="1000" y="200" width="120" height="28" rx="4" fill="#020817" stroke="#00f2fe" stroke-width="1"/>
  <text x="1010" y="218" fill="#00f2fe" font-family="Space Grotesk" font-size="12">100m Transect</text>

  <!-- 50m -->
  <line x1="220" y1="360" x2="1100" y2="360" stroke="#00f2fe" stroke-width="2.5" stroke-dasharray="8,5"/>
  <rect x="1000" y="340" width="120" height="28" rx="4" fill="#020817" stroke="#00f2fe" stroke-width="1"/>
  <text x="1010" y="358" fill="#00f2fe" font-family="Space Grotesk" font-size="12">50m Transect</text>

  <!-- 20m -->
  <line x1="220" y1="480" x2="1100" y2="480" stroke="#00f2fe" stroke-width="2.5" stroke-dasharray="8,5"/>
  <rect x="1000" y="460" width="120" height="28" rx="4" fill="#020817" stroke="#00f2fe" stroke-width="1"/>
  <text x="1010" y="478" fill="#00f2fe" font-family="Space Grotesk" font-size="12">20m Transect</text>

  <!-- UAV Laser Scanning Drone -->
  <g transform="translate(620, 210)">
    <line x1="-30" y1="-15" x2="30" y2="15" stroke="#00f2fe" stroke-width="4"/>
    <line x1="-30" y1="15" x2="30" y2="-15" stroke="#00f2fe" stroke-width="4"/>
    <circle cx="0" cy="0" r="12" fill="#020817" stroke="#00f2fe" stroke-width="3"/>
    <circle cx="-30" cy="-15" r="6" fill="#a78bfa"/>
    <circle cx="30" cy="-15" r="6" fill="#a78bfa"/>
    <circle cx="-30" cy="15" r="6" fill="#a78bfa"/>
    <circle cx="30" cy="15" r="6" fill="#a78bfa"/>
    <line x1="0" y1="12" x2="120" y2="150" stroke="url(#cyanGrad)" stroke-width="3.5"/>
  </g>

  <!-- Footer Info Banner -->
  <rect x="50" y="650" width="1100" height="70" rx="8" fill="rgba(2,8,23,0.9)" stroke="#a78bfa" stroke-width="1.5"/>
  <text x="80" y="692" fill="#a78bfa" font-family="Space Grotesk, sans-serif" font-size="15" font-weight="bold">TELEMETRY STATS: Path-Integrated CH₄ 2.45 ppm-m | Wind U-Vector 4.2 m/s | GNSS/RTK &lt;5cm | Status: Active Audit</text>

</svg>