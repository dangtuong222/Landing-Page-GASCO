<?xml version="1.0" encoding="UTF-8"?>
<svg width="1200" height="800" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#020817"/>
      <stop offset="100%" stop-color="#0b172a"/>
    </linearGradient>
    <linearGradient id="cyanGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#00f2fe"/>
      <stop offset="100%" stop-color="#a78bfa"/>
    </linearGradient>
    <linearGradient id="plumeGrad" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="rgba(0, 242, 254, 0.5)"/>
      <stop offset="60%" stop-color="rgba(167, 139, 250, 0.3)"/>
      <stop offset="100%" stop-color="rgba(0, 242, 254, 0)"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background Base -->
  <rect width="1200" height="800" fill="url(#bgGrad)"/>
  <rect width="1200" height="800" fill="url(#grid)"/>

  
  <rect x="50" y="50" width="1100" height="700" rx="16" fill="rgba(15,23,42,0.9)" stroke="#00f2fe" stroke-width="2"/>
  <text x="80" y="110" fill="#00f2fe" font-family="Space Grotesk" font-size="28" font-weight="bold">CAPABILITY 01: MULTI-ALTITUDE TRANSECT &amp; VERTICAL PROFILING</text>
  <text x="80" y="145" fill="#94a3b8" font-family="Inter" font-size="16">Đo nền phía đón gió (upwind) và các mặt cắt hạ lưu (downwind transects) ở nhiều cao độ (20m, 50m, 100m AGL)</text>

  <!-- Cross section flight line diagram -->
  <line x1="120" y1="240" x2="1080" y2="240" stroke="#00f2fe" stroke-width="3" stroke-dasharray="8,6"/>
  <line x1="120" y1="360" x2="1080" y2="360" stroke="#00f2fe" stroke-width="3" stroke-dasharray="8,6"/>
  <line x1="120" y1="480" x2="1080" y2="480" stroke="#00f2fe" stroke-width="3" stroke-dasharray="8,6"/>

  <text x="140" y="225" fill="#00f2fe" font-family="Space Grotesk" font-size="16" font-weight="bold">Tầng Cao Độ 100m (Upper Boundary)</text>
  <text x="140" y="345" fill="#00f2fe" font-family="Space Grotesk" font-size="16" font-weight="bold">Tầng Cao Độ 50m (Core Plume Transect)</text>
  <text x="140" y="465" fill="#00f2fe" font-family="Space Grotesk" font-size="16" font-weight="bold">Tầng Cao Độ 20m (Near-Surface Layer)</text>

  <!-- Landfill Cell Slope -->
  <path d="M 120 620 L 500 520 L 900 550 L 1080 620" fill="none" stroke="#a78bfa" stroke-width="4"/>
  <text x="520" y="580" fill="#a78bfa" font-family="Space Grotesk" font-size="16">Bề Mặt Bãi Chôn Lấp (Landfill Surface)</text>

  <!-- Status Box -->
  <rect x="80" y="650" width="1040" height="60" rx="8" fill="#020817" stroke="#00f2fe" stroke-width="1.5"/>
  <text x="110" y="687" fill="#00f2fe" font-family="Space Grotesk" font-size="15" font-weight="bold">TRẠNG THÁI: Quy Trình Khảo Sát Chuẩn | Đáp ứng tiêu chuẩn Open-Path Laser Spectroscopy S0294</text>

</svg>