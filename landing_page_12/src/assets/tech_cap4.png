<?xml version="1.0" encoding="UTF-8"?>
<svg width="1200" height="800" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#020817"/>
      <stop offset="100%" stop-color="#0b172a"/>
    </linearGradient>
    <linearGradient id="cyanGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#00f2fe"/>
      <stop offset="100%" stop-color="#a78bfa"/>
    </linearGradient>
    <linearGradient id="plumeGrad" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="rgba(0, 242, 254, 0.5)"/>
      <stop offset="60%" stop-color="rgba(167, 139, 250, 0.3)"/>
      <stop offset="100%" stop-color="rgba(0, 242, 254, 0)"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background Base -->
  <rect width="1200" height="800" fill="url(#bgGrad)"/>
  <rect width="1200" height="800" fill="url(#grid)"/>

  
  <rect x="50" y="50" width="1100" height="700" rx="16" fill="rgba(15,23,42,0.9)" stroke="#00f2fe" stroke-width="2"/>
  <text x="80" y="110" fill="#00f2fe" font-family="Space Grotesk" font-size="28" font-weight="bold">CAPABILITY 04: MASS BALANCE &amp; CAMPAIGN FLUX RATE (kg CH₄/h)</text>
  <text x="80" y="145" fill="#94a3b8" font-family="Inter" font-size="16">Ước tính tốc độ phát thải theo chiến dịch bằng phương pháp cân bằng khối lượng hoặc nghịch đảo khi đủ điều kiện</text>

  <!-- Flux calculation box formula -->
  <rect x="150" y="240" width="900" height="160" rx="12" fill="#020817" stroke="#00f2fe" stroke-width="2"/>
  <text x="600" y="310" fill="#00f2fe" font-family="Space Grotesk" font-size="26" text-anchor="middle" font-weight="bold">Q_CH4 = ∬ (C_downwind - C_upwind) * U_wind * dA</text>
  <text x="600" y="360" fill="#94a3b8" font-family="Inter" font-size="15" text-anchor="middle">Thuật toán tích phân mặt cắt vuông góc hướng gió (Cross-wind Flux Plane Integration)</text>

  <!-- Sensitivity graph simulation -->
  <rect x="150" y="440" width="900" height="170" rx="12" fill="#020817" stroke="#a78bfa" stroke-width="1.5"/>
  <text x="180" y="480" fill="#a78bfa" font-family="Space Grotesk" font-size="16" font-weight="bold">Ước tính Tốc độ Phát thải (Campaign Emission Rate):</text>
  <text x="180" y="520" fill="#ffffff" font-family="Space Grotesk" font-size="22" font-weight="bold">142.5 kg CH₄/h  (Giới hạn Bất định: ± 18.2%)</text>
  <text x="180" y="560" fill="#f59e0b" font-family="Inter" font-size="13">*Lưu ý: Kết quả chiến dịch không tự động đại diện cho phát thải tổng hợp tháng hoặc cả năm.</text>

  <!-- Status Box -->
  <rect x="80" y="650" width="1040" height="60" rx="8" fill="#020817" stroke="#00f2fe" stroke-width="1.5"/>
  <text x="110" y="687" fill="#00f2fe" font-family="Space Grotesk" font-size="15" font-weight="bold">TRẠNG THÁI: Mô Hình Cân Bằng Khối Lượng | Yêu cầu ranh giới bãi &amp; giả định khí tượng đạt chuẩn</text>

</svg>